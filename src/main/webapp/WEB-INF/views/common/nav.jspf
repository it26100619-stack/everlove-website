<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<div class="topbar"><div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
<a class="brand" href="${ctx}/home"><img src="${ctx}/images/favicon.png" alt="" style="height:30px;vertical-align:middle;background:#fff;border-radius:8px;padding:2px 4px"> Admin Panel</a>
<div class="links"><a href="${ctx}/site">View website</a><a href="${ctx}/home">Dashboard</a><a href="${ctx}/vendors">Vendors</a><a href="${ctx}/bookings">Bookings</a><a href="${ctx}/plans">Plans</a><a href="${ctx}/reviews">Reviews</a>
<c:if test="${sessionScope.user.admin}"><a href="${ctx}/users">Couples</a><a href="${ctx}/admins">Admins</a></c:if>
<a href="${ctx}/logout">Logout (<c:out value="${sessionScope.user.name}"/>)</a></div></div></div>
<script>
document.addEventListener('click', function (e) {
  var a = e.target.closest('a');
  if (!a || a.onclick || a.target || e.ctrlKey || e.metaKey) return;
  if (a.getAttribute('href') === null || a.getAttribute('href').charAt(0) === '#') return;
  if (a.href.indexOf(location.origin) !== 0) return;
  e.preventDefault();
  document.body.classList.add('leaving');
  setTimeout(function () { location.href = a.href; }, 220);
});
window.addEventListener('pageshow', function () { document.body.classList.remove('leaving'); });
</script>
